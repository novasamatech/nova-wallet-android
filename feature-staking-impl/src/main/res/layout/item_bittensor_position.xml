<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_primary_list_item_corner_12_solid"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/positionIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The title keeps a minimum width and may wrap to a second line; a large amount wraps instead of squeezing it away. -->
    <LinearLayout
        android:id="@+id/positionTexts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/positionValues"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@id/positionIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="96dp">

        <TextView
            android:id="@+id/positionTitle"
            style="@style/TextAppearance.NovaFoundation.SemiBold.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/positionSubtitle"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/positionSubtitleProgress"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/positionValues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/positionAmountProgress"
        app:layout_constraintStart_toEndOf="@id/positionTexts"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/positionAmount"
            style="@style/TextAppearance.NovaFoundation.SemiBold.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/positionFiat"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/positionChange"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/positionChangeProgress"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/positionAmountProgress"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/positionChevron"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/positionChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/icon_secondary" />
</androidx.constraintlayout.widget.ConstraintLayout>
