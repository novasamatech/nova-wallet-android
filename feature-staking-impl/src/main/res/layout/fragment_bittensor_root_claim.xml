<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/secondary_screen_background">

    <io.novafoundation.nova.common.view.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/bittensor_claim_action" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <io.novafoundation.nova.feature_wallet_api.presentation.view.extrinsic.GenericExtrinsicInformationView
            android:id="@+id/information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <io.novafoundation.nova.common.view.TableView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <io.novafoundation.nova.common.view.TableCellView
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/bittensor_claim_redeemable"
                app:primaryValue="—" />

            <io.novafoundation.nova.common.view.TableCellView
                android:id="@+id/forfeited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/bittensor_claim_forfeited"
                app:primaryValue="—" />

            <io.novafoundation.nova.common.view.TableCellView
                android:id="@+id/validator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/bittensor_validator"
                app:primaryValueEndIcon="@drawable/ic_info" />
        </io.novafoundation.nova.common.view.TableView>

        <TextView
            android:id="@+id/remaining"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/feeCaption"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/error"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_negative"
            android:visibility="gone" />

    </LinearLayout></ScrollView>

    <io.novafoundation.nova.common.view.PrimaryButton
        android:id="@+id/confirm"
        style="@style/Widget.Nova.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="@string/bittensor_claim_action" />
</LinearLayout>
