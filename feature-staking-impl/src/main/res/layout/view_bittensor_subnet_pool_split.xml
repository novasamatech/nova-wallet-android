<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- Figma: each share sits right after its title; the alpha pair is pushed to the end. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nativeShareTitle"
            style="@style/TextAppearance.NovaFoundation.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bittensor_native_pool"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/nativeShareValue"
            style="@style/TextAppearance.NovaFoundation.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/text_primary"
            tools:text="6.9%" />

        <ProgressBar
            android:id="@+id/nativeShareProgress"
            style="@style/Widget.Nova.ProgressBar.Indeterminate"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1000"
            android:minWidth="12dp" />

        <TextView
            android:id="@+id/alphaShareTitle"
            style="@style/TextAppearance.NovaFoundation.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bittensor_alpha_in_pool"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/alphaShareValue"
            style="@style/TextAppearance.NovaFoundation.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/text_primary"
            tools:text="93.1%" />

        <ProgressBar
            android:id="@+id/alphaShareProgress"
            style="@style/Widget.Nova.ProgressBar.Indeterminate"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bars"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/nativeBar"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <Space
            android:id="@+id/gap"
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/alphaBar"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
