<?xml version="1.0" encoding="utf-8"?>
<!-- "Validator" row with the name over the estimated APY (iOS SubtensorPickValidatorCell).
     No vertical padding on the root: TableView overwrites it on its first and last rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/validatorRowTitle"
        style="@style/TextAppearance.NovaFoundation.Body1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/bittensor_validator"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="8dp"
        android:layout_weight="1"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/validatorRowContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/validatorRowIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:visibility="gone"
                tools:src="@tools:sample/avatars"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/validatorRowName"
                style="@style/TextAppearance.NovaFoundation.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                tools:text="tao.bot" />
        </LinearLayout>

        <TextView
            android:id="@+id/validatorRowRate"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/text_positive"
            android:visibility="gone"
            tools:text="Est. 33.99% APY"
            tools:visibility="visible" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/validatorRowProgress"
        style="@style/Widget.Nova.ProgressBar.Indeterminate"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/validatorRowChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/icon_secondary" />
</LinearLayout>
