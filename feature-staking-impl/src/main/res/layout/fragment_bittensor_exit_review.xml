<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_screen_background">

    <LinearLayout
        android:id="@+id/reviewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.novafoundation.nova.common.view.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerVisible="false" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <io.novafoundation.nova.common.view.AlertView
                    android:id="@+id/priceMoved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/bittensor_exit_price_moved"
                    android:visibility="gone"
                    app:alertMode="info" />

                <io.novafoundation.nova.feature_wallet_api.presentation.view.amount.PrimaryAmountView
                    android:id="@+id/primaryAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" />

                <io.novafoundation.nova.feature_wallet_api.presentation.view.swap.SwapAssetsView
                    android:id="@+id/assets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <io.novafoundation.nova.feature_wallet_api.presentation.view.extrinsic.GenericExtrinsicInformationView
                    android:id="@+id/information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <io.novafoundation.nova.common.view.TableView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:drawDividers="true">

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/stakingType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/staking_staking_type"
                        app:primaryValue="@string/bittensor_root_staking" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/bittensor_exchange_rate"
                        app:titleIcon="@drawable/ic_info" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/averagePrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/bittensor_exit_avg_buy_price"
                        app:primaryValue="—"
                        app:titleIcon="@drawable/ic_info" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/earned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/bittensor_you_will_earn"
                        app:primaryValue="—"
                        app:titleIcon="@drawable/ic_info" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/slippage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/swap_slippage_title"
                        app:titleIcon="@drawable/ic_info" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/validator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/bittensor_validator"
                        app:titleIcon="@drawable/ic_info" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/stakeAfter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/bittensor_exit_stake_after"
                        app:shouldDrawDivider="false" />

                    <io.novafoundation.nova.feature_wallet_api.presentation.view.FeeView
                        android:id="@+id/networkFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/network_fee"
                        app:titleIcon="@drawable/ic_info" />
                </io.novafoundation.nova.common.view.TableView>

                <io.novafoundation.nova.common.view.TableView
                    android:id="@+id/validators"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:drawDividers="true"
                    app:title="@string/bittensor_validators_count" />

                <io.novafoundation.nova.common.view.Switch
                    android:id="@+id/mevProtection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:title="@string/bittensor_mev_title"
                    app:subtitle="@string/bittensor_mev_description" />

                <io.novafoundation.nova.common.view.TableView
                    android:id="@+id/saleWalletInformation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:drawDividers="true">

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/saleWallet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/common_wallet" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/saleAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/common_account"
                        app:primaryValueEndIcon="@drawable/ic_info" />
                </io.novafoundation.nova.common.view.TableView>

                <TextView
                    android:id="@+id/profitCaption"
                    style="@style/TextAppearance.NovaFoundation.Regular.Caption1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/bittensor_sale_profit_disclaimer"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/commissionCaption"
                    style="@style/TextAppearance.NovaFoundation.Regular.Caption1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/feeCaption"
                    style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_secondary" />


            </LinearLayout>
        </ScrollView>

        <io.novafoundation.nova.common.view.PrimaryButton
            android:id="@+id/confirm"
            style="@style/Widget.Nova.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"
            android:text="@string/common_confirm" />
    </LinearLayout>

    <include
        android:id="@+id/execution"
        layout="@layout/view_bittensor_subnet_execution"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <io.novafoundation.nova.common.view.PrimaryButton
        android:id="@+id/done"
        style="@style/Widget.Nova.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/common_done"
        android:visibility="gone" />
    <io.novafoundation.nova.common.view.PrimaryButton
        android:id="@+id/retryExecution"
        style="@style/Widget.Nova.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/common_try_again"
        android:visibility="gone" />
</FrameLayout>
