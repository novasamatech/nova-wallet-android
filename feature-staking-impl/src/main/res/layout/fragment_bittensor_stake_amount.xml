<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_screen_background"
    android:orientation="vertical">
    <io.novafoundation.nova.common.view.Toolbar
        android:id="@+id/bittensorStakeAmountToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVisible="false"
        app:titleText="@string/bittensor_stake_to_root" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <io.novafoundation.nova.feature_wallet_api.presentation.view.amount.ChooseAmountView
                android:id="@+id/bittensorStakeAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                app:title="@string/bittensor_you_stake" />

            <io.novafoundation.nova.common.view.TableView
                android:id="@+id/bittensorStakeAmountDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:childrenPaddingBottom="0dp"
                app:childrenPaddingEnd="16dp"
                app:childrenPaddingStart="16dp"
                app:childrenPaddingTop="0dp"
                app:drawDividers="true">
                <io.novafoundation.nova.common.view.TableCellView
                    android:id="@+id/bittensorStakeAmountValidator"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:primaryValueEndIcon="@drawable/ic_chevron_right_16"
                    app:primaryValueIconTint="@color/icon_secondary"
                    app:title="@string/bittensor_validator" />

                <io.novafoundation.nova.common.view.TableCellView
                    android:id="@+id/bittensorStakeAmountApy"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:primaryValueStyle="positive"
                    app:title="@string/bittensor_apy" />

                <io.novafoundation.nova.feature_wallet_api.presentation.view.FeeView
                    android:id="@+id/bittensorStakeAmountFee"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:shouldDrawDivider="false"
                    app:title="@string/network_fee" />
            </io.novafoundation.nova.common.view.TableView>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@color/block_background"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">
        <io.novafoundation.nova.common.view.PrimaryButton
            android:id="@+id/bittensorStakeAmountContinue"
            style="@style/Widget.Nova.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_continue" />
    </FrameLayout>
</LinearLayout>
