<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_screen_background"
    android:orientation="vertical" >

    <io.novafoundation.nova.common.view.Toolbar
        android:id="@+id/bittensorStakeAmountToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVisible="false"
        app:titleText="@string/bittensor_stake_to_root" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <include
                android:id="@+id/fundingCard"
                layout="@layout/view_bittensor_get_asset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:visibility="gone" />

            <io.novafoundation.nova.feature_wallet_api.presentation.view.amount.ChooseAmountView
                android:id="@+id/bittensorStakeAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                app:title="@string/bittensor_you_stake" />

            <io.novafoundation.nova.common.view.AlertView
                android:id="@+id/reserveWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:alertMode="warning" />

            <!-- Quick pick from "Where to stake" (iOS rootEntryPresentation = quickPickRoot). -->
            <TextView
                android:id="@+id/quickPickSection"
                style="@style/TextAppearance.NovaFoundation.SemiBold.Caps1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/bittensor_quick_root_section"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/quickPickCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary_list_item_corner_12_solid"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/quickPickHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/quickPickIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_token_container"
                        android:importantForAccessibility="no"
                        android:padding="4dp" />

                    <TextView
                        style="@style/TextAppearance.NovaFoundation.SemiBold.SubHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bittensor_stake_to_root" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/icon_secondary" />
                </LinearLayout>

                <io.novafoundation.nova.common.view.TableView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:childrenPaddingBottom="0dp"
                    app:childrenPaddingEnd="0dp"
                    app:childrenPaddingStart="0dp"
                    app:childrenPaddingTop="0dp"
                    app:drawDividers="true"
                    app:showBackground="false">

                    <include
                        android:id="@+id/quickPickValidator"
                        layout="@layout/view_bittensor_validator_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <io.novafoundation.nova.feature_wallet_api.presentation.view.FeeView
                        android:id="@+id/quickPickFee"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:title="@string/network_fee" />
                </io.novafoundation.nova.common.view.TableView>

                <TextView
                    android:id="@+id/quickPickSeeAll"
                    style="@style/TextAppearance.NovaFoundation.SemiBold.Footnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="2dp"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp"
                    android:text="@string/bittensor_see_all_subnets"
                    android:textColor="@color/button_text_accent"
                    app:drawableEndCompat="@drawable/ic_chevron_right_16"
                    app:drawableTint="@color/icon_accent" />
            </LinearLayout>

            <!-- Root picked in the subnet list (iOS SubtensorValidatorCardView). -->
            <!-- TableView shows itself while it has visible rows, so the variant toggles this container. -->
            <FrameLayout
                android:id="@+id/pickerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <io.novafoundation.nova.common.view.TableView
                    android:id="@+id/pickerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:childrenPaddingBottom="0dp"
                    app:childrenPaddingEnd="16dp"
                    app:childrenPaddingStart="16dp"
                    app:childrenPaddingTop="0dp"
                    app:drawDividers="true">

                    <LinearLayout
                        android:id="@+id/pickerValidator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="60dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/pickerValidatorIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginVertical="10dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pickerValidatorName"
                                style="@style/TextAppearance.NovaFoundation.SemiBold.SubHeadline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1" />

                            <TextView
                                style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/bittensor_validator" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pickerValidatorRate"
                                style="@style/TextAppearance.NovaFoundation.SemiBold.SubHeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_positive" />

                            <ProgressBar
                                android:id="@+id/pickerValidatorRateProgress"
                                style="@style/Widget.Nova.ProgressBar.Indeterminate"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:visibility="gone" />

                            <TextView
                                style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/bittensor_estimated_apy" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/icon_secondary" />
                    </LinearLayout>

                    <io.novafoundation.nova.feature_wallet_api.presentation.view.FeeView
                        android:id="@+id/pickerFee"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:title="@string/network_fee" />
                </io.novafoundation.nova.common.view.TableView>
            </FrameLayout>

            <TextView
                android:id="@+id/pickerSeeAll"
                style="@style/TextAppearance.NovaFoundation.SemiBold.Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:text="@string/bittensor_see_all_subnets"
                android:textColor="@color/button_text_accent"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_chevron_right_16"
                app:drawableTint="@color/icon_accent" />

            <!-- Add stake to an existing root position. -->
            <FrameLayout
                android:id="@+id/addStakeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <io.novafoundation.nova.common.view.TableView
                    android:id="@+id/bittensorStakeAmountDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:childrenPaddingBottom="0dp"
                    app:childrenPaddingEnd="16dp"
                    app:childrenPaddingStart="16dp"
                    app:childrenPaddingTop="0dp"
                    app:drawDividers="true" >

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/bittensorStakeAmountValidator"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:primaryValueEndIcon="@drawable/ic_chevron_right_16"
                        app:primaryValueIconTint="@color/icon_secondary"
                        app:title="@string/bittensor_validator" />

                    <io.novafoundation.nova.common.view.TableCellView
                        android:id="@+id/bittensorStakeAmountApy"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:primaryValueStyle="positive"
                        app:title="@string/bittensor_apy" />

                    <io.novafoundation.nova.feature_wallet_api.presentation.view.FeeView
                        android:id="@+id/bittensorStakeAmountFee"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:title="@string/network_fee" />
                </io.novafoundation.nova.common.view.TableView>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/addStakeCaption"
        style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/continueContainer"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@drawable/bg_bittensor_bottom_button_container"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" >

        <io.novafoundation.nova.common.view.PrimaryButton
            android:id="@+id/bittensorStakeAmountContinue"
            style="@style/Widget.Nova.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_continue" />
    </FrameLayout>
</LinearLayout>
