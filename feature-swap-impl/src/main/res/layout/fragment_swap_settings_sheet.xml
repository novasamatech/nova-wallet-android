<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">
    <io.novafoundation.nova.common.view.Toolbar
        android:id="@+id/swapSettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentBackground="@android:color/transparent"
        app:dividerVisible="false"
        app:homeButtonVisible="false"
        app:iconRight="@drawable/ic_close"
        app:titleText="@string/swap_settings_title" />
    <TextView
        android:id="@+id/swapSettingsSlippageTitle"
        style="@style/TextAppearance.NovaFoundation.SemiBold.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:drawablePadding="8dp"
        android:text="@string/swap_slippage"
        android:textColor="@color/text_primary"
        app:drawableEndCompat="@drawable/ic_info" />
    <LinearLayout
        android:id="@+id/swapSettingsPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp" />
    <io.novafoundation.nova.common.view.TipsInputField
        android:id="@+id/swapSettingsCustomInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:inputType="numberDecimal"
        android:visibility="gone"
        app:postfix="@string/common_percent" />
    <io.novafoundation.nova.common.view.AlertView
        android:id="@+id/swapSettingsAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:alertMode="warning" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp">
        <io.novafoundation.nova.common.view.PrimaryButton
            android:id="@+id/swapSettingsReset"
            style="@style/Widget.Nova.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/common_reset" />
        <io.novafoundation.nova.common.view.PrimaryButton
            android:id="@+id/swapSettingsApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/common_apply" />
    </LinearLayout>
</LinearLayout>
