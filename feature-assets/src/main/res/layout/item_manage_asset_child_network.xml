<?xml version="1.0" encoding="utf-8"?>
<!-- Figma NW-2145 "Enable network" child: 52dp tall, indented 52dp past the 16dp list inset -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_primary_list_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="68dp"
    android:paddingEnd="16dp"
    tools:background="@color/secondary_screen_background">

    <ImageView
        android:id="@+id/itemManageAssetChildNetworkIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        tools:src="@color/android_system_accent" />

    <TextView
        android:id="@+id/itemManageAssetChildNetworkTitle"
        style="@style/TextAppearance.NovaFoundation.Regular.SubHeadline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        tools:text="Ethereum" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/itemManageAssetChildNetworkEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
