<?xml version="1.0" encoding="utf-8"?>
<!-- Figma NW-2145 "Manage token row": 56dp tall, 40dp logo, 12dp gaps, 20dp side padding -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_primary_list_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    tools:background="@color/secondary_screen_background">

    <ImageView
        android:id="@+id/itemManageAssetGroupIcon"
        style="@style/Widget.Nova.AssetIcon.OnColor"
        android:layout_width="40dp"
        android:layout_height="40dp"
        tools:src="@drawable/ic_token_dot_colored" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemManageAssetGroupTitle"
            style="@style/TextAppearance.NovaFoundation.SemiBold.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            tools:text="DOT" />

        <TextView
            android:id="@+id/itemManageAssetGroupSubtitle"
            style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            tools:text="Polkadot" />
    </LinearLayout>

    <ImageView
        android:id="@+id/itemManageAssetGroupExpand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_chevron_down"
        app:tint="@color/icon_secondary" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/itemManageAssetGroupEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
